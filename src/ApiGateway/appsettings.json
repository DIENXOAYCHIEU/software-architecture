{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "trip-route": {
        "ClusterId": "trip-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/trip/{**catch-all}" }
      },
      "matching-route": {
        "ClusterId": "matching-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/api/matching/{**catch-all}" }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": { "Path": "/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://auth_service:8081" }
        }
      },
      "trip-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://trip_service:8082" }
        }
      },
      "matching-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://matching_service:8083" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "dest1": { "Address": "http://payment_service:8084" }
        }
      }
    }
  }
}
