{
  "info": {
    "_postman_id": "9aef72a0-76d9-4c2f-b4e1-3b4bdb8ad2a5",
    "name": "PaymentService",
    "description": "Postman collection dùng để kiểm thử các API thanh toán, idempotency, ledger và refund của PaymentService.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "payment_url",
      "value": "http://localhost:8084"
    },
    {
      "key": "trip_id",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "rider_id",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "payment_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-payment-001"
          },
          {
            "key": "X-Correlation-ID",
            "value": "postman-correlation-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tripId\": \"{{trip_id}}\",\n  \"riderId\": \"{{rider_id}}\",\n  \"amount\": 85000,\n  \"currency\": \"VND\",\n  \"method\": \"Card\",\n  \"paymentToken\": \"tok_event_demo\"\n}"
        },
        "url": {
          "raw": "{{payment_url}}/payments",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Tạo payment mới. Response thành công lần đầu là 201 Created."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    if (body.id) pm.collectionVariables.set('payment_id', body.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Replay Payment (same idempotency key)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-payment-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tripId\": \"{{trip_id}}\",\n  \"riderId\": \"{{rider_id}}\",\n  \"amount\": 85000,\n  \"currency\": \"VND\",\n  \"method\": \"Card\",\n  \"paymentToken\": \"tok_event_demo\"\n}"
        },
        "url": {
          "raw": "{{payment_url}}/payments",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Gửi lại cùng request. Expected: 200 OK, cùng payment ID và không charge gateway lần hai."
      }
    },
    {
      "name": "Idempotency Conflict (same key, different payload)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-payment-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tripId\": \"{{trip_id}}\",\n  \"riderId\": \"{{rider_id}}\",\n  \"amount\": 90000,\n  \"currency\": \"VND\",\n  \"method\": \"Card\",\n  \"paymentToken\": \"tok_event_demo\"\n}"
        },
        "url": {
          "raw": "{{payment_url}}/payments",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Expected: 409 Conflict vì cùng Idempotency-Key nhưng payload khác."
      }
    },
    {
      "name": "Get Payment by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/payments/{{payment_id}}",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments",
            "{{payment_id}}"
          ]
        }
      }
    },
    {
      "name": "Get Payments by Trip",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/payments/by-trip/{{trip_id}}",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments",
            "by-trip",
            "{{trip_id}}"
          ]
        }
      }
    },
    {
      "name": "Get Payment Ledger",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/payments/{{payment_id}}/ledger",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments",
            "{{payment_id}}",
            "ledger"
          ]
        },
        "description": "Kiểm tra ledger double-entry: tổng debit phải bằng tổng credit."
      }
    },
    {
      "name": "Refund Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "postman-refund-001"
          }
        ],
        "url": {
          "raw": "{{payment_url}}/payments/{{payment_id}}/refund",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments",
            "{{payment_id}}",
            "refund"
          ]
        },
        "description": "Refund payment đã Succeeded."
      }
    },
    {
      "name": "Replay Refund (same idempotency key)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "postman-refund-001"
          }
        ],
        "url": {
          "raw": "{{payment_url}}/payments/{{payment_id}}/refund",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "payments",
            "{{payment_id}}",
            "refund"
          ]
        },
        "description": "Expected: 200 OK, cùng payment ID và không refund gateway lần hai."
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/health",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Kiểm tra service đang chạy."
      }
    },
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/health/live",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "health",
            "live"
          ]
        },
        "description": "Kiểm tra process còn sống."
      }
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/health/ready",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "health",
            "ready"
          ]
        },
        "description": "Kiểm tra PaymentService đã kết nối được MySQL."
      }
    },
    {
      "name": "Prometheus Metrics",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{payment_url}}/metrics",
          "host": [
            "{{payment_url}}"
          ],
          "path": [
            "metrics"
          ]
        },
        "description": "Đọc ASP.NET Core, runtime và custom payment metrics."
      }
    }
  ]
}
